PORT=8000
NODE_ENV=development

MONGO_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/"
# Optional: use public DNS if your local DNS refuses SRV lookups
DNS_SERVERS=8.8.8.8,1.1.1.1

SESSION_SECRET="change-me"
SESSION_EXPIRES_IN="1d"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_GOOGLE_CALLBACK_URL=http://localhost:5173/google/oauth/callback

# Optional: email reminders for tasks due soon / overdue.
# Leave SMTP_HOST out to skip sending (reminders still show in the app).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, an App Password as SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="FlowSpace <you@gmail.com>"
# REMINDER_INTERVAL_MINUTES=15
